@inherits LayoutComponentBase
@implements IDisposable
@using GestionVacaciones.Data.Services
@inject SolicitudesService Solicitudes
@inject IEmpleadoActualProvider EmpleadoActual
@inject ILogger<MainLayout> Registro

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" data-estado="@_estado">
        <MudText Typo="Typo.h6">Gestión de Vacaciones</MudText>
        <MudSpacer />
        @* FEAT-002 (Bloque 5). Visible SOLO si el dominio contesta que hay equipo a cargo -- nunca por
           una consulta propia de este componente (ComponentesSinAccesoADatosTests lo refuerza). *@
        @if (_tieneEquipoACargo)
        {
            <MudLink Href="/autorizaciones"
                     Color="Color.Inherit"
                     Underline="Underline.None"
                     data-testid="@IdDelLinkDeAutorizaciones">
                Autorizaciones
            </MudLink>
        }
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    /// <summary>Atributo que publica si ya se resolvió la visibilidad del link (para los tests).</summary>
    public const string AtributoDelEstado = "data-estado";

    /// <summary>Todavía no se preguntó, o se está preguntando, si hay equipo a cargo.</summary>
    public const string EstadoCargando = "menu-cargando";

    /// <summary>Ya se resolvió: el link aparece o no según <see cref="_tieneEquipoACargo"/>.</summary>
    public const string EstadoListo = "menu-listo";

    public const string IdDelLinkDeAutorizaciones = "link-autorizaciones";

    private string _estado = EstadoCargando;
    private bool _tieneEquipoACargo;

    /// <summary>
    /// Se suscribe ANTES de la primera evaluación (FIX-001): un componente que no es ancestro de
    /// <c>SelectorDeEmpleado</c> no se entera solo cuando la identidad cambia después de arrancar, y
    /// hasta este fix no volvía a preguntar nunca -- el link quedaba fijo en lo que hubiera contestado
    /// al primerísimo render, casi siempre "sin identidad todavía".
    /// </summary>
    protected override void OnInitialized() =>
        EmpleadoActual.IdentidadCambiada += AlCambiarLaIdentidad;

    /// <summary>Primera evaluación del circuito, con la identidad que haya en ese momento (a menudo ninguna).</summary>
    protected override async Task OnInitializedAsync()
    {
        await EvaluarSiTieneEquipoACargoAsync();
        _estado = EstadoListo;
    }

    /// <summary>
    /// Pregunta al dominio si el empleado actual tiene equipo a cargo (Block 5, SolicitudesService).
    /// Compartido entre la evaluación inicial y la reactiva (FIX-001) a propósito: los dos catches de
    /// abajo solo necesitan un lugar donde ser correctos, y ejercerlos desde cualquiera de las dos
    /// rutas cubre a la otra.
    /// </summary>
    private async Task EvaluarSiTieneEquipoACargoAsync()
    {
        try
        {
            _tieneEquipoACargo = await Solicitudes.TieneEquipoACargoAsync();
        }
        catch (SinEmpleadoSeleccionadoException)
        {
            // Estado esperado del circuito recién abierto, no un error: mismo criterio que
            // MisSolicitudes.RecargarAsync ya aplica a esta misma excepción. No se loguea.
            _tieneEquipoACargo = false;
        }
        catch (Exception excepcion)
        {
            // No es un catch silencioso: queda registrado y el link simplemente no aparece.
            Registro.LogError(excepcion, "No se pudo determinar si el empleado actual tiene equipo a cargo.");

            _tieneEquipoACargo = false;
        }
    }

    /// <summary>
    /// Reacciona a <see cref="IEmpleadoActualProvider.IdentidadCambiada"/> (FIX-001): sin esto, el
    /// link quedaba fijo en lo que la evaluación inicial hubiera contestado, sin importar qué elija
    /// después el usuario. La excepción, si la hay, queda contenida DENTRO de la continuación que
    /// recibe <c>InvokeAsync</c> -- mitigación del riesgo MEDIUM del modelo de amenazas
    /// (docs/daw/security/threat-FIX-001.md): sin esa contención, un fallo transitorio de
    /// <c>TieneEquipoACargoAsync</c> podría tumbar el circuito completo en vez de solo ocultar el link.
    /// </summary>
    private void AlCambiarLaIdentidad(object? remitente, EventArgs argumentos) =>
        _ = InvokeAsync(async () =>
        {
            await EvaluarSiTieneEquipoACargoAsync();
            StateHasChanged();
        });

    /// <summary>Desuscribe del proveedor de identidad. Primer <c>event</c> del repo: sin precedente que seguir.</summary>
    public void Dispose() => EmpleadoActual.IdentidadCambiada -= AlCambiarLaIdentidad;
}
