<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GestionVacaciones.Data</RootNamespace>
    <AssemblyName>GestionVacaciones.Data</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <!--
      PrivateAssets=all: las herramientas de diseño no fluyen a Web ni al artefacto publicado.
      NO se restringe IncludeAssets (el bloque que traen las plantillas excluye `compile`): este
      proyecto necesita los assets de compilación para implementar IDesignTimeDbContextFactory, sin
      el cual `dotnet ef` no encuentra el contexto —se registra con AddDbContextFactory y no con
      AddDbContext, así que el camino habitual por el host no lo ve—.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
