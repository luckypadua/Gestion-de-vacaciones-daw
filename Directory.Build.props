<Project>

  <!--
    Propiedades comunes a TODOS los proyectos .NET del repositorio.
    Vive en la raíz, no en src/: el proyecto de tests/ está fuera de src/ y, colocado allí, no
    heredaría net10.0 ni TreatWarningsAsErrors, con lo que NFR-07 se cumpliría a medias.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

</Project>
